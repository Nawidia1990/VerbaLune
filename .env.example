# Copy this file to .env.local for local development.
# Get a key from https://console.anthropic.com/settings/keys
# NEVER put this in a file you commit to git or ship to the browser —
# it's only read by the serverless function in /api/chat.js.
ANTHROPIC_API_KEY=sk-ant-...

# Firebase web config — get these from Firebase console → Project settings →
# your web app → SDK setup and configuration → Config. Unlike the key above,
# these ARE meant to be public/client-side; that's normal for Firebase.
# In Vite, any var prefixed VITE_ is exposed to the browser bundle on purpose.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
